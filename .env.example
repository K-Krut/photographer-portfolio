# Site and booking configuration. The BOOKING_* variables are read on the server only.
# Copy this file to .env.local for development; on Vercel add each variable
# in Project Settings -> Environment Variables. Booking counts as configured
# only when every required variable is set; otherwise the booking page shows
# the "write to us" text instead of the calendar.

# --- Site address (required in production) ---

# Public address of the site, without a trailing slash. Used for the links in
# booking e-mails (cancel and book-again buttons), canonical URLs, the sitemap
# and link previews. Unlike the BOOKING_* variables it is read at build time,
# so redeploy after changing it. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Google Calendar (required) ---

# Service account e-mail from the Google Cloud project (the "client_email"
# field of the downloaded service account key).
BOOKING_GOOGLE_CLIENT_EMAIL=photo-booking@photo-booking.iam.gserviceaccount.com

# Service account private key (the "private_key" field of the key file).
# Keep the whole PEM block in one line with "\n" for the line breaks, as below.
BOOKING_GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Calendar where the site creates reservation events. The service account
# needs "Make changes to events" access to it.
BOOKING_CALENDAR_ID=abcdef1234567890abcdef1234567890@group.calendar.google.com

# Comma-separated ids of the photographer's own calendars whose events block
# booking time. "See only free/busy" access is enough for these.
BOOKING_BLOCKING_CALENDAR_IDS=photographer@gmail.com,work1234567890@group.calendar.google.com

# --- Daily window (optional) ---

# Hours open for booking on every day, Warsaw time, "HH:MM-HH:MM".
# Defaults to 08:00-22:00 when unset.
BOOKING_WINDOW=08:00-22:00

# --- Gmail SMTP (required) ---

# Gmail address the notifications are sent from and its app password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
BOOKING_GMAIL_ADDRESS=photographer@gmail.com
BOOKING_GMAIL_APP_PASSWORD=abcdefghijklmnop

# E-mail that receives the photographer's notifications (optional).
# Defaults to BOOKING_GMAIL_ADDRESS when unset.
BOOKING_NOTIFY_EMAIL=photographer@gmail.com

# --- Cancel links (required) ---

# Random secret used to sign the cancel links. Generate one with
# `openssl rand -hex 32` and never change it while reservations exist,
# or the links in already sent e-mails stop working.
BOOKING_TOKEN_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Telegram (optional) ---

# Bot token from @BotFather and the chat id of the photographer's chat with
# the bot. Booking works without these; only e-mail is sent then.
BOOKING_TELEGRAM_BOT_TOKEN=1234567890:AAEabcdefghijklmnopqrstuvwxyz0123456
BOOKING_TELEGRAM_CHAT_ID=123456789

# --- Testing ---

# "1" or "true" replaces Google Calendar, Gmail and Telegram with the
# in-memory fake used by the e2e tests. Never set it on Vercel.
# BOOKING_FAKE=1
